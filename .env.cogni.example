# .env.cogni — your two Cogni agent accounts (copy to .env.cogni; gitignored via .env*).
#   NODE     = this node's own hub (https://<slug>.cognidao.org): the primary plane
#              for knowledge + interaction. Session cognition recalls it.
#   OPERATOR = owning operator host: platform guidance, traces and authorized CI/CD.
# Mint each: POST <baseUrl>/api/v1/agent/register {"name":"<workspace>"}.
# Read merged operator guides `cicd-e2e-required-sequence` and `agent-check-own-access`.
# Node-local credentials never authenticate operator actions; register/reuse your own
# agent Bearer on the operator host you address and verify GET /api/v1/agent/me there.
# grantsAvailable:false means unknown. Request owner-approved node.flight/developer
# access normally; never use shared vendor/service keys or borrowed human credentials.

# ── NODE account (primary) ──
COGNI_NODE_API_KEY=
COGNI_NODE_USER_ID=
COGNI_NODE_BILLING_ACCOUNT=
COGNI_NODE_ID=

# ── OPERATOR account (platform guidance, traces, CI/CD) ──
COGNI_OPERATOR_NODE_API_KEY=
# Compatibility with older saved environments: COGNI_OPERATOR_API_KEY is an alias
# only when the canonical variable is absent. Canonical wins when both exist.
# Never retry another key or host after a 401/403.
# COGNI_OPERATOR_API_KEY=
COGNI_OPERATOR_USER_ID=
COGNI_OPERATOR_BILLING_ACCOUNT=
