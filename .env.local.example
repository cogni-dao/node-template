# Standalone node-template local development. This is configuration, not a secret source.
# Copy to .env.local (gitignored). Generate each replace-me value locally.
# POC prerequisite: existing shared LOCAL PostgreSQL, Doltgres, Redis, Temporal,
# scheduler-worker and a gateway configured for THIS node. No operator checkout
# is used by the launcher. A cold-machine substrate installer is not included.
# Guide draft: https://cognidao.org/knowledge/inbox/contrib-flock-leader-conductor-32ab8994
# Existing contract: https://cognidao.org/knowledge/agent-infrastructure-expert
NODE_ENV=development
# Parse native Dolt commit timestamps on the same UTC basis as containers.
TZ=UTC
APP_ENV=production
DEPLOY_ENVIRONMENT=local
PORT=3200
LANGGRAPH_PORT=2025
APP_BASE_URL=http://127.0.0.1:3200
NEXTAUTH_URL=http://127.0.0.1:3200
LANGGRAPH_DEV_URL=http://127.0.0.1:2025

# Provision separate roles and the node-owned database first. Runtime uses the
# first two DSNs. Only the migration command uses DATABASE_MIGRATION_URL.
DATABASE_URL=postgresql://app_node_template:replace-me@127.0.0.1:55432/cogni_node_template
DATABASE_SERVICE_URL=postgresql://service_node_template:replace-me@127.0.0.1:55432/cogni_node_template
DATABASE_MIGRATION_URL=postgresql://migration_node_template:replace-me@127.0.0.1:55432/cogni_node_template
# Doltgres uses its engine role; PostgreSQL role restrictions remain separate.
DOLTGRES_URL=postgresql://postgres:replace-me@127.0.0.1:5435/knowledge_node_template
REDIS_URL=redis://127.0.0.1:6379
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=cogni-local
TEMPORAL_TASK_QUEUE=scheduler-tasks
SCHEDULER_WORKER_HEALTH_URL=http://127.0.0.1:9001
# Shared worker must route b927a9dd-6132-4fc9-a51e-e3cee2568e3c to this app.
# Match its LOCAL scheduler token; do not copy a deployed node token.
SCHEDULER_API_TOKEN=replace-me-with-at-least-32-local-characters

# openssl rand -hex 32. Keep auth and billing tokens separate.
AUTH_SECRET=replace-me-with-at-least-32-local-characters
BILLING_INGEST_TOKEN=replace-me-with-at-least-32-local-characters
# Own local gateway primary identity must match this node, and callbacks must
# reach http://host.docker.internal:3200 with the same BILLING_INGEST_TOKEN.
LITELLM_BASE_URL=http://127.0.0.1:4001
LITELLM_MASTER_KEY=sk-replace-me-with-a-fresh-local-gateway-key
EVM_RPC_URL=https://mainnet.base.org
DB_POOL_MAX=1
DB_SERVICE_POOL_MAX=2
GOVERNANCE_SCHEDULES_ENABLED=false
# Optional native LangGraph traces. Set both when you need backend readback.
# Use your authorized development project and key, never commit the key.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-me-with-your-development-key
# LANGSMITH_PROJECT=replace-me-with-your-development-project
MCP_CONFIG_PATH=./config/mcp.servers.json
# Leave DOLTHUB_REMOTE_URL unset. Local changes must not push a deployed hub.
