{
  "name": "@cogni-dao/knowledge-base-ui",
  "version": "0.13.0",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cogni-DAO/node-template.git",
    "directory": "packages/knowledge-base-ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js",
      "default": "./dist/knowledge.js"
    },
    "./goals": {
      "types": "./dist/goals.d.ts",
      "import": "./dist/goals.js",
      "default": "./dist/goals.js"
    },
    "./graph-3d": {
      "types": "./dist/graph-3d.d.ts",
      "import": "./dist/graph-3d.js",
      "default": "./dist/graph-3d.js"
    },
    "./tailwind-source.css": "./tailwind-source.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "tailwind-source.css"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')){console.error('ERROR: dist/index.js missing'); process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "@cogni/work-items": ">=0.7.0",
    "@cogni/knowledge-store": ">=0.13.0 <1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.20.0",
    "clsx": "^2.0.0",
    "lucide-react": ">=0.552.0 <1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.0.0",
    "@tanstack/react-query": "^5",
    "react-force-graph-3d": ">=1.29.1 <2",
    "@cogni-dao/metrics": ">=0.10.0 <1",
    "recharts": "^2.15.4",
    "@cogni/agent-grants": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@cogni/knowledge-store": {
      "optional": true
    },
    "@cogni-dao/metrics": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "@cogni/agent-grants": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "jsdom": "^27.1.0",
    "lucide-react": "^0.552.0",
    "radix-ui": "^1.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.9",
    "@cogni/work-items": "workspace:@cogni-dao/work-items@*",
    "@cogni/knowledge-store": "workspace:@cogni-dao/knowledge-store@*",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/user-event": "^14.6.1",
    "@tanstack/react-query": "^5.90.2",
    "react-force-graph-3d": "^1.29.1",
    "@cogni-dao/metrics": "workspace:*",
    "recharts": "^2.15.4",
    "@cogni/agent-grants": "workspace:@cogni-dao/agent-grants@*"
  }
}
