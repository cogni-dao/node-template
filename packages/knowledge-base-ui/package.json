{
  "name": "@cogni-dao/knowledge-base-ui",
  "version": "0.5.0",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cogni-DAO/node-template.git",
    "directory": "packages/knowledge-base-ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind-source.css": "./tailwind-source.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "tailwind-source.css"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')){console.error('ERROR: dist/index.js missing'); process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "@cogni/work-items": ">=0.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.20.0",
    "clsx": "^2.0.0",
    "lucide-react": ">=0.552.0 <1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.0.0",
    "@tanstack/react-query": ">=5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
