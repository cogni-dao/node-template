{
  "name": "@cogni-dao/metrics",
  "version": "0.15.1",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogni-dao/node-template.git",
    "directory": "packages/metrics"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "import": "./dist/adapters/postgres.js",
      "default": "./dist/adapters/postgres.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js",
      "default": "./dist/knowledge.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.js",
      "default": "./dist/sources.js"
    },
    "./no-inline-history": {
      "types": "./dist/no-inline-history.d.ts",
      "import": "./dist/no-inline-history.js",
      "default": "./dist/no-inline-history.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup && tsc -b --force",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "postgres": "^3.4.5",
    "drizzle-orm": "^0.44.7"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.0.9",
    "@types/node": "^22",
    "drizzle-orm": "^0.44.7"
  }
}
