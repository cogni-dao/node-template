{
  "name": "@cogni-dao/attribution",
  "version": "0.1.1",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogni-dao/node-template.git",
    "directory": "packages/attribution-ledger"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./epoch-window": {
      "types": "./dist/epoch-window.d.ts",
      "import": "./dist/epoch-window.js",
      "default": "./dist/epoch-window.js"
    },
    "./allocation": {
      "types": "./dist/allocation.d.ts",
      "import": "./dist/allocation.js",
      "default": "./dist/allocation.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')){console.error('ERROR: dist/index.js missing'); process.exit(1)}\"",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.0.9"
  }
}
