{
  "name": "@cogni-dao/agent-grants",
  "version": "0.4.0",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cogni-DAO/node-template.git",
    "directory": "packages/agent-grants"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials/index.d.ts",
      "import": "./dist/credentials.js",
      "default": "./dist/credentials.js"
    },
    "./conformance": {
      "types": "./dist/credentials/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    },
    "./enrollment": {
      "types": "./dist/enrollment/index.d.ts",
      "import": "./dist/enrollment.js",
      "default": "./dist/enrollment.js"
    },
    "./enrollment-conformance": {
      "types": "./dist/enrollment/conformance.d.ts",
      "import": "./dist/enrollment-conformance.js",
      "default": "./dist/enrollment-conformance.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup && tsc -b --force",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^3.1.4"
  }
}
