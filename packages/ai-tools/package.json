{
  "name": "@cogni-dao/ai-tools",
  "version": "0.3.0",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cogni-DAO/node-template.git",
    "directory": "packages/ai-tools"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/bundled/index.d.ts",
      "import": "./dist/bundled/index.js",
      "default": "./dist/bundled/index.js"
    }
  },
  "types": "./dist/bundled/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/bundled/index.js')){console.error('ERROR: dist/bundled/index.js missing'); process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ci": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cogni/ai-core": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4",
    "@cogni-dao/work-items": "workspace:*",
    "@cogni-dao/knowledge-store": "workspace:*"
  },
  "peerDependencies": {
    "@cogni-dao/work-items": "0.4.0",
    "@cogni-dao/knowledge-store": "0.8.0"
  }
}
